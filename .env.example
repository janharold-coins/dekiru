# Postgres (Neon). Copy the .env.local snippet from Vercel → Storage → your Neon database.
# Leave unset to run from the JSON seed with no database.
DATABASE_URL=

# Google sign-in (Google Cloud Console → Google Auth Platform → Clients). Leave unset to run open locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs login sessions: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Optional: only needed if the app isn't on localhost:3000 or the Vercel production domain.
# BETTER_AUTH_URL=
# Optional: defaults to coins.ph
# ALLOWED_EMAIL_DOMAIN=
